n","sym":"$s$","pron":"\"s\"","meaning":"Schichtdicke (Diffusions-Kontext, wie $d$ in §2, andere Notation)","unit":"m"},{"section":"Lateinische Formelbuchstaben","sym":"$s_d$","pron":"\"s-d\"","meaning":"äquivalente Luftschichtdicke ($s_d=\\mu\\cdot s$)","unit":"m"},{"section":"Lateinische Formelbuchstaben","sym":"$u$, $u_m$, $u_v$","pron":"\"u\", \"u-m\", \"u-v\"","meaning":"Baustoff-Wassergehalt (moisture content), massen-/volumenbezogen","unit":"dimensionslos bzw. %"},{"section":"Lateinische Formelbuchstaben","sym":"$\\dot V$","pron":"\"V-Punkt\"","meaning":"Volumenstrom (volume flow rate)","unit":"m³/s"},{"section":"Lateinische Formelbuchstaben","sym":"$\\dot m_D$","pron":"\"m-Punkt-D\"","meaning":"Wasserdampfproduktion (Feuchtequelle im Raum)","unit":"kg/s"},{"section":"Lateinische Formelbuchstaben","sym":"$c_{sa}$, $c_{si}$","pron":"\"c-s-a\", \"c-s-i\"","meaning":"Sättigungskonzentration außen/innen","unit":"g/m³"},{"section":"Lateinische Formelbuchstaben","sym":"$T_a$","pron":"\"T-a\"","meaning":"Außentemperatur in VO8s Feuchtebilanz-Formel — ⚠ **Konventions-Konflikt**: Rest des Kurses nutzt Subscript \"e\" (außen), VO8 nutzt hier \"a\"","unit":"K"},{"section":"Lateinische Formelbuchstaben","sym":"$\\theta_L$","pron":"\"Theta-L\"","meaning":"Lufttemperatur (air temperature) — in Formelsammlung §7 seit VO6 verwendet, hier zum ersten Mal in dieser Tabelle nachgetragen","unit":"°C"},{"section":"Lateinische Formelbuchstaben","sym":"$\\theta_U$","pron":"\"Theta-U\"","meaning":"Umgebungstemperatur/Umschließungsflächentemperatur — in §7 seit VO6, hier nachgetragen","unit":"°C"},{"section":"Lateinische Formelbuchstaben","sym":"$t_a$","pron":"\"t-a\" (klein)","meaning":"Lufttemperatur (UTCI-Input) — ⚠ gleiche Bedeutung wie $\\theta_L$/$\\theta_a$, aber lateinisches Klein-t statt Theta, UTCI-eigene Konvention","unit":"°C"},{"section":"Lateinische Formelbuchstaben","sym":"$t_{mrt}$","pron":"\"t-m-r-t\"","meaning":"mittlere Strahlungstemperatur (UTCI-Input) — ⚠ gleiche 