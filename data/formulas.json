[{"n":1,"title":"Mechanik / Energie-Grundlagen","items":[{"tex":"K = \\frac{1}{2} m v^2 \\quad \\text{(kinetische Energie)}, \\qquad U = m g h \\quad \\text{(potentielle Energie)}, \\qquad E = K + U","label":"","vo":[2]}]},{"n":2,"title":"Wärmeleitung (Fourier)","items":[{"tex":"\\dot q = -\\lambda \\cdot \\frac{\\delta T}{\\delta n} \\qquad \\text{[W/m²]}","label":"","vo":[2]},{"tex":"\\frac{\\Delta Q}{\\Delta t} = \\lambda \\cdot A \\cdot \\frac{T_1-T_2}{l}, \\qquad \\dot q = \\frac{\\lambda}{d}(\\theta_{si}-\\theta_{se})","label":"","vo":[2]},{"tex":"\\dot q = \\frac{1}{\\displaystyle\\sum_{k=1}^{n} \\frac{d_k}{\\lambda_k}} \\cdot (\\theta_{si}-\\theta_{se})","label":"Mehrschichtig (Reihenschaltung)","vo":[2]},{"tex":"R = \\frac{d}{\\lambda} \\quad \\text{(einschichtig)}, \\qquad R = \\sum_{k=1}^{n} \\frac{d_k}{\\lambda_k} \\quad \\text{(mehrschichtig)} \\qquad [\\text{m}^2\\text{K/W}]","label":"Wärmedurchlasswiderstand","vo":[2]},{"tex":"\\dot q = \\Phi = h_{CV} \\cdot A \\cdot (\\theta_f - \\theta_S)","label":"","vo":[2]}]},{"n":3,"title":"Wärmeübergang / Wärmedurchgang (U-Wert)","items":[{"tex":"R_{si} = \\frac{1}{h_i}, \\qquad R_{se} = \\frac{1}{h_e}","label":"","vo":[3]},{"tex":"R_T = R_{si} + R_{\\text{Schichten}} + R_{se}","label":"","vo":[3]},{"tex":"U = \\frac{1}{R_T} \\qquad [\\text{W/(m}^2\\text{K)}]","label":"U-Wert (Wärmedurchgangskoeffizient)","vo":[3]},{"tex":"\\dot q = U \\cdot (\\theta_i - \\theta_e)","label":"","vo":[3]},{"tex":"U = \\cfrac{1}{\\dfrac{1}{h_e} + \\dfrac{d_1}{\\lambda_1} + \\dfrac{d_2}{\\lambda_2} + \\cdots + \\dfrac{d_n}{\\lambda_n} + \\dfrac{1}{h_i}}","label":"Vollformel (Serienschichten inkl. Übergangswiderstände)","vo":[3]},{"tex":"\\theta_{si} = \\theta_i - \\dot q \\cdot R_{si} = \\theta_i - \\frac{U}{h_i}(\\theta_i-\\theta_e)","label":"Grenzflächentemperatur (innen)","vo":[3]},{"tex":"\\theta_n = \\theta_{n-1} - \\dot q \\cdot R_n","label":"Temperatur an Schichtgrenze $n$","vo":[3]},{"tex":"f_{Rsi} = \\frac{\\theta_{si,min} - \\theta_e}{\\theta_i - \\theta_e}, \\qquad f_P = \\frac{\\theta_P - \\theta_e}{\\theta_i - \\theta_e}","label":"Temperaturfaktor (Kondensationsrisiko am kältesten Punkt)","vo":[3,4]},{"tex":"R_T = \\frac{R'_T + R''_T}{2}, \\qquad \\frac{1}{R'_T} = \\sum_k \\frac{f_k}{R_{Tk}}, \\qquad R_{Tk} = R_{si} + \\sum_{1}^{n} \\frac{d_n}{\\lambda_n} + R_{se}","label":"Kombinierter (parallel + seriell) Widerstand","vo":[3,4]},{"tex":"R''_T = R_{si} + \\sum_j R_j + R_{se}, \\qquad \\frac{1}{R_j} = \\sum_k \\frac{f_k}{R_k}","label":"","vo":[3,4]},{"tex":"U_W = \\frac{\\sum A_g U_g + \\sum A_f U_f + \\sum l_g \\psi_g}{A_f + A_g} \\qquad (g=\\text{Glas},\\ f=\\text{Rahmen})","label":"Fenster-U-Wert","vo":[4]},{"tex":"U_m = \\frac{\\sum_{i=1}^{N} A_i U_i}{\\sum_{i=1}^{N} A_i}","label":"Flächengewichteter mittlerer U-Wert","vo":[3]}]},{"n":4,"title":"Wärmestrahlung","items":[{"tex":"\\sigma = 5.6697\\times10^{-8}\\ \\text{W m}^{-2}\\text{K}^{-4}, \\qquad M_s = \\sigma T^4, \\qquad M_s = \\varepsilon \\sigma T^4","label":"","vo":[2]},{"tex":"\\lambda_{max} = \\frac{2896\\times10^{-6}}{T}, \\qquad \\varepsilon = \\frac{M}{M_S} = \\alpha \\ \\text{(Kirchhoff)}","label":"","vo":[2]}]},{"n":5,"title":"Wärmebrücken","items":[{"tex":"L_{2D} = \\frac{\\dot Q}{\\theta_i - \\theta_e} \\qquad \\text{(2D-Wärmedurchgangskoeffizient)}","label":"","vo":[4]},{"tex":"\\psi = L_{2D} - \\sum(U_i \\cdot l_i)","label":"Psi-Wert","vo":[4]},{"tex":"L_{3D} = \\sum(U_i A_i) + \\sum(\\psi_k l_k) + \\chi \\qquad (\\chi = \\text{Punktwärmebrücken-Koeffizient [W/K]})","label":"","vo":[4]},{"tex":"H_T = \\sum_{i=1}^{n} A_i U_i + \\sum_{j=1}^{m} L_j \\Psi_j + \\sum_{k=1}^{l} z_k \\chi_k","label":"Gebäude-Transmissionswärmeverlust","vo":[2,4]},{"tex":"f_{Rsi} = \\frac{\\theta_{si,min}-\\theta_e}{\\theta_i-\\theta_e}","label":"Temperaturfaktor $f_{Rsi}$","vo":[4]}]},{"n":6,"title":"Gasgesetze / Thermodynamik","items":[{"tex":"p V = \\text{const} \\quad \\text{(Boyle-Mariotte)}, \\qquad \\frac{V_1}{V_2} = \\frac{T_1}{T_2} \\quad \\text{(Gay-Lussac)}","label":"","vo":[8]},{"tex":"pV = mRT \\quad \\text{(Masse)}, \\qquad pV = nR_{universell}T \\quad \\text{(Stoffmenge)}","label":"","vo":[8]},{"tex":"p_{Gesamt} = \\sum_{i=1}^{n} p_i \\quad \\text{(Dalton)}, \\qquad V_{Gesamt} = \\sum_{i=1}^{n} V_i","label":"","vo":[8]},{"tex":"n = \\frac{m}{M}","label":"Stoffmenge","vo":[8]},{"tex":"\\varphi_i = \\varphi_a \\cdot \\frac{C_{sa}}{c_{si}} \\cdot \\frac{T_a}{T_i} + \\frac{\\dot m_D}{V \\cdot L \\cdot c_{si}}","label":"Feuchtebilanz Raumluft","vo":[8]},{"tex":"S = c \\cdot \\rho \\ \\text{(volumetrisch)}, \\qquad C = c \\cdot m = C_m \\cdot n, \\qquad C_m = c \\cdot M","label":"Wärmekapazität","vo":[4]},{"tex":"HGT_{20/12} = \\sum_{d=1}^{N} (20 - \\bar\\theta_e)","label":"Heizgradtage","vo":[5]}]},{"n":7,"title":"Luftfeuchte / Massenströme, Lüftung","items":[{"tex":"\\varphi = \\frac{x}{x_s} = \\frac{c}{c_s} = \\frac{p}{p_s}","label":"Relative Luftfeuchtigkeit","vo":[8]},{"tex":"\\dot m = \\dot V \\cdot \\rho, \\qquad \\dot V = v \\cdot A","label":"Massen- und Volumenstrom","vo":[8]},{"tex":"\\dot m = -D \\cdot \\frac{\\Delta c}{\\Delta x}","label":"Fick'sches Gesetz (Dampfdiffusion)","vo":[8]},{"tex":"\\dot m_T = \\dot m_e - \\dot m_a","label":"","vo":[8]},{"tex":"\\dot m_e = \\frac{\\Delta p_e}{1.5\\times10^6 \\cdot S_{d,e}}, \\qquad \\dot m_a = \\frac{\\Delta p_a}{1.5\\times10^6 \\cdot S_{d,a}}","label":"","vo":[8]},{"tex":"s_d = \\mu \\cdot s","label":"$s_d$-Wert (äquivalente Luftschichtdicke)","vo":[8,11]},{"tex":"G_K = 1440 \\cdot \\dot m_T \\quad \\text{(Winter)}, \\qquad G_A = 2160 \\cdot \\dot m_A","label":"Kondensatmenge","vo":[8,11]},{"tex":"\\Theta_S = \\varphi^{1/8}(110+\\theta_L) - 110","label":"Sättigungstemperatur (Taupunkt-artig)","vo":[8]},{"tex":"\\Delta h = h_2 - h_1 \\qquad \\text{(Mischungs-/Zustandsänderung ablesen)}","label":"h,x-Diagramm (Mollier, feuchte Luft)","vo":[8]},{"tex":"\\theta_{OP} = \\frac{\\theta_L + \\theta_U}{2}","label":"Operative Temperatur"