bel":"","vo":[4,7]},{"tex":"\\Phi_S = A \\cdot F_r \\cdot g \\cdot E_{sT}","label":"Solare Gewinne","vo":[7]},{"tex":"g = \\tau_s + h_i \\cdot \\frac{\\alpha_s}{h_e+h_i}","label":"g-Wert","vo":[7]},{"tex":"\\rho_S + \\alpha_S + \\tau_S = 1, \\qquad \\tau_S = \\frac{\\tau_1\\tau_2}{1-\\rho_1\\rho_2} \\quad \\text{(Doppelverglasung)}","label":"Verglasung — Aufteilung & Mehrfachverglasung","vo":[7]},{"tex":"f_c = \\frac{g_{total}}{g}","label":"Sonnenschutz-Abminderungsfaktor","vo":[7]},{"tex":"\\Phi_I = P_P + P_A + P_L \\qquad (P=\\text{Personen},\\ A=\\text{Apparate},\\ L=\\text{Licht})","label":"Interne Gewinne","vo":[7,9]},{"tex":"\\gamma = \\frac{\\Phi_S+\\Phi_I}{\\Phi_T+\\Phi_V} \\quad (\\gamma = 0 \\text{ falls } \\Phi_T+\\Phi_V < 0)","label":"Ausnutzungsgrad interner/solarer Gewinne","vo":[7,9]},{"tex":"\\tau = \\frac{C}{H_T+H_V}, \\qquad a = a_0 + \\frac{\\tau}{\\tau_0}","label":"Zeitkonstante des Gebäudes","vo":[7,9]},{"tex":"\\eta_h = \\frac{1-\\gamma_h^a}{1-\\gamma_h^{a+1}}","label":"Ausnutzungsgrad (EN ISO 13790 / ÖNORM B 8110-6)","vo":[7,9]},{"tex":"HWB = \\frac{Q_H}{A_E} \\qquad \\text{(flächenbezogener Heizwärmebedarf)}","label":"","vo":[7]},{"tex":"E_H = \\frac{1}{3}\\left[E_0 \\sin h - E_{S,H}\\right], \\qquad E_0 \\approx 1390\\ \\text{W/m}^2 \\ \\text{(Solarkonstante)}","label":"Direktstrahlung — Horizontalfläche (Näherung)","vo":[5,14]},{"tex":"E_{Glob} = E_{S,H} + E_H","label":"","vo":[5,14]},{"tex":"I_a = I_{dir,norm}\\cdot\\cos\\eta, \\qquad \\cos\\eta = \\cos h \\cdot \\cos(a_0\\pm a_w)","label":"Direkte Strahlung auf geneigte Fläche","vo":[14]},{"tex":"Q_S = \\sum_j \\left[I_j \\times A_{g,j} \\times f_{s,j} \\times g_{w,j}\\right]","label":"Solare Wärmegewinne — Jahressummenverfahren (vereinfacht)","vo":[14,15]},{"tex":"\\theta_{op} \\le \\frac{1}{3}T_{NAT,13} + 21.8°\\text{C}","label":"Sommerlicher Wärmeschutz — Grenzwert operative Temperatur (OIB-RL6, 4.9.1a)","vo":[14,15]}]},{"n":10,"title":"Ventilation / Luftwechsel","items":[{"tex":"n = \\frac{q_V}{V} \\qquad \\text{(Luftwechselrate)}","label":"","vo":[7]},{"tex":"\\Phi_V = G_a c_a(\\theta_i-\\theta_e) = H_V(\\theta_i-\\theta_e)","label":"","vo":[7]},{"tex":"H_V = \\frac{n}{3600}\\cdot V \\cdot \\rho_a \\cdot c_a = 0.34n \\cdot V","label":"","vo":[7]},{"tex":"Q_V = 0.34 \\cdot n \\cdot V \\cdot HGT \\cdot 24 \\cdot 3600 \\ [\\text{J}]","label":"","vo":[9]},{"tex":"Q_T = U_m \\cdot A_T \\cdot HGT \\cdot 24 \\cdot 3600 \\ [\\text{J}]","label":"","vo":[9]},{"tex":"Q = C \\cdot \\Delta p^m","label":"Luftdichtheit (Blower-Door-Test)","vo":[9]}]},{"n":11,"title":"Speicherfähigkeit / Wärmeeindringung (instationär)","items":[{"tex":"C = \\sum A_i C_i, \\qquad C_i = \\sum_{\\text{Schichten}} \\rho_j c_j d_c","label":"","vo":[9]},{"tex":"C = f_{BW} \\cdot V, \\qquad C = \\frac{V}{A_T}","label":"","vo":[9]},{"tex":"q = \\frac{\\Phi}{A} = \\frac{\\theta_{si}-\\theta_{se}}{d/\\lambda} = \\frac{\\theta_{si}-\\theta_{se}}{R}","label":"","vo":[9]},{"tex":"Q = c \\cdot \\rho \\cdot d(\\theta_2-\\theta_1)","label":"","vo":[9]},{"tex":"a = \\frac{\\lambda}{\\rho \\cdot c}","label":"Temperaturleitfähigkeit","vo":[10]},{"tex":"b = \\sqrt{\\lambda \\cdot \\rho \\cdot c}","label":"Wärmeeindringkoeffizient","vo":[2,10]},{"tex":"\\theta_c = \\frac{b_1\\theta_1+b_2\\theta_2}{b_1+b_2}","label":"Kontakttemperatur zweier Körper","vo":[10]},{"tex":"\\frac{\\partial\\theta}{\\partial t} = a\\left(\\frac{\\partial^2\\theta}{\\partial x^2}+\\frac{\\partial^2\\theta}{\\partial y^2}+\\frac{\\partial^2\\theta}{\\partial z^2}\\right) \\quad \\text{(3D)}, \\qquad \\frac{\\partial\\theta}{\\partial t} = a\\frac{\\partial^2\\theta}{\\partial x^2} \\quad \\text{(1D)}","label":"Fourier'sche Differentialgleichung (instationäre Wärmeleitung)","vo":[10]},{"tex":"G \\cdot E_{ST} + P_I + P_{HC} - H(\\theta_i-\\theta_e) = \\frac{\\mathrm{d}\\Phi_{store}}{\\mathrm{d}t}, \\qquad \\Delta\\Phi_{stored} = C \\cdot \\Delta\\theta_i","label":"Dynamische Wärmebilanz eines Raumes (Zeitschritt-Modell)","vo":[10]},{"tex":"\\theta_i + \\tau \\frac{\\mathrm{d}\\theta_i}{\\mathrm{d}t} = \\theta_e + \\gamma E_{ST}, \\qquad \\tau = \\frac{C}{H}, \\qquad \\gamma = \\frac{G}{H}","label":"Neutraltemperatur (freilaufende Zone, ohne Heizung/Kühlung)","vo":[10]}]},{"n":12,"title":"Ökologische Baustoffbewertung (OI3-Index)","items":[{"tex":"OI_{PECnr}(x) = \\frac{1}{10}(x-500) \\qquad \\text{(nicht erneuerbarer Primärenergieinhalt)}","label":"","vo":[13]},{"tex":"OI_{GWP}(x) = \\frac{1}{2}(x+50) \\qquad \\text{(Treibhauspotenzial)}","label":"","vo":[13]},{"tex":"OI_{AP}(x) = \\frac{100}{0.25}(x-0.21) \\qquad \\text{(Versauerungspotenzial)}","label":"","vo":[13]},{"tex":"OI3_{KON} = \\frac{1}{3}OI_{PECnr} + \\frac{1}{3}OI_{GWP} + \\frac{1}{3}OI_{AP}","label":"Notation korrigiert (2026-08-20)","vo":[13]},{"tex":"\\Delta OI3 = \\frac{1}{3}\\left(0.1\\,PENRT_{A1\\text{-}A3} + 0.5\\,GWP_{A1\\text{-}A3} + 400\\,AP_{A1\\text{-}A3}\\right)","label":"Bauteilschicht-Beitrag (IBO-Leitfaden, Kap. 3.3)","vo":[13]},{"tex":"OI3_{BGX} = \\frac{\\sum_{i=1}^{N} A_i \\cdot OI3_{KON,i}}{\\sum_{i=1}^{N} A_i}","label":"","vo":[13]},{"tex":"OI3_{BGX,lc} = \\frac{3 \\cdot OI3_{BGX}}{2+l_c}, \\qquad l_c = \\frac{V}{A}","label":"Kompaktheits-korrigiert","vo":[13]},{"tex":"OI3_{BGX,BGF} = \\frac{\\sum_{i=1}^{N} A_i \\cdot OI3_{KON,i}}{BGF}","label":"","vo":[13]}]},{"n":13,"title":"Referenztabellen","items":[]}]